*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body{
    display: flex;
    background: #f4f6f9;
}

/* Sidebar */

.sidebar{
    width: 240px;
    height: 100vh;
    background: #0d6efd;
    color: white;
    padding: 30px 20px;
    position: fixed;
}

.sidebar h2{
    text-align: center;
    margin-bottom: 40px;
    font-size: 30px;
}

.sidebar ul{
    list-style: none;
}

.sidebar ul li{
    padding: 15px;
    margin-bottom: 10px;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
}

.sidebar ul li:hover{
    background: rgba(255,255,255,0.2);
}

/* Main */

.main{
    margin-left: 240px;
    width: calc(100% - 240px);
    padding: 30px;
}

/* Header */

.header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.header h1{
    color: #222;
}

.header input{
    padding: 12px;
    width: 250px;
    border: 1px solid #ccc;
    border-radius: 8px;
}

/* Cards */

.cards{
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.card{
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    text-align: center;
}

.card h2{
    color: #0d6efd;
    margin-bottom: 10px;
    font-size: 35px;
}

/* Form */

.form-section{
    background: white;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.form-section h2{
    margin-bottom: 20px;
    color: #222;
}

.form-group{
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
}

.form-group input{
    flex: 1;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
}

button{
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    color: white;
    background: #0d6efd;
    transition: 0.3s;
}

button:hover{
    opacity: 0.9;
}

/* Table */

.table-section{
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.table-section h2{
    margin-bottom: 20px;
}

table{
    width: 100%;
    border-collapse: collapse;
}

table th,
table td{
    padding: 15px;
    text-align: center;
    border-bottom: 1px solid #ddd;
}

table th{
    background: #0d6efd;
    color: white;
}

.edit{
    background: green;
}

.delete{
    background: red;
}
