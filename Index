<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h2>SMS</h2>

        <ul>
            <li>Dashboard</li>
            <li>Add Student</li>
            <li>Student List</li>
            <li>Courses</li>
            <li>Attendance</li>
            <li>Reports</li>
            <li>Logout</li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main">

        <!-- Top Header -->
        <div class="header">
            <h1>Student Management System</h1>

            <input type="text" placeholder="Search Student...">
        </div>

        <!-- Dashboard Cards -->
        <div class="cards">

            <div class="card">
                <h2>120</h2>
                <p>Total Students</p>
            </div>

            <div class="card">
                <h2>15</h2>
                <p>Courses</p>
            </div>

            <div class="card">
                <h2>92%</h2>
                <p>Attendance</p>
            </div>

            <div class="card">
                <h2>10</h2>
                <p>Teachers</p>
            </div>

        </div>

        <!-- Add Student Form -->
        <div class="form-section">

            <h2>Add Student</h2>

            <form>

                <div class="form-group">
                    <input type="text" placeholder="Student Name">
                    <input type="email" placeholder="Email">
                </div>

                <div class="form-group">
                    <input type="text" placeholder="Department">
                    <input type="text" placeholder="Phone Number">
                </div>

                <div class="form-group">
                    <input type="number" placeholder="Marks">
                    <input type="text" placeholder="Attendance">
                </div>

                <button type="submit">Add Student</button>

            </form>

        </div>

        <!-- Student Table -->
        <div class="table-section">

            <h2>Student Records</h2>

            <table>

                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Marks</th>
                    <th>Attendance</th>
                    <th>Action</th>
                </tr>

                <tr>
                    <td>101</td>
                    <td>Prithika G</td>
                    <td>Bsc</td>
                    <td>89</td>
                    <td>95%</td>
                    <td>
                        <button class="edit">Edit</button>
                        <button class="delete">Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>102</td>
                    <td>Abinesh M</td>
                    <td>B.Com</td>
                    <td>76</td>
                    <td>88%</td>
                    <td>
                        <button class="edit">Edit</button>
                        <button class="delete">Delete</button>
                    </td>
                </tr>

            </table>

        </div>

    </div>

</body>
</html>
